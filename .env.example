# ─────────────────────────────────────────────────────────────
# Server (copy to server/.env)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB. Transactions need a replica set (Atlas clusters are replica sets).
# For local development without MongoDB, run `npm run dev:db` (in-memory replica set).
MONGO_URI=mongodb://127.0.0.1:27017/premium

# Comma-separated list is allowed for CLIENT_URL (first entry is used in emails/links)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# Set to the parent domain only when client and API share one (e.g. .example.com)
COOKIE_DOMAIN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=premium-ecommerce

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BlueMart Store <no-reply@example.com>"

# Optional – reserved for a future shared cache / job queue. The app runs without it.
REDIS_URL=

LOG_LEVEL=info

# Seed credentials (development only)
SEED_ADMIN_EMAIL=admin@bluemart.store
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@bluemart.store
SEED_CUSTOMER_PASSWORD=Customer@12345

# ─────────────────────────────────────────────────────────────
# Client (copy to client/.env) – only VITE_* values reach the browser.
# Never put secrets here.
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api/v1
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=BlueMart
